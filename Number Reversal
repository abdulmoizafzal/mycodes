
#include <iostream>
using namespace std;

int main() {
    int number, reversed = 0;

    cout << "Enter a number (0-999999999): ";
    cin >> number;

    if (number < 0 || number > 999999999) {
        cout << "Invalid input";
        return 0;
    }

    while (number > 0) {
        int digit = number % 10;
        reversed = reversed * 10 + digit;
        number /= 10;
    }

    cout << "Reversed number: " << reversed;

    return 0;
}
