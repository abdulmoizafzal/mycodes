
#include <iostream>
using namespace std;

int main() {
    int number, original, reversed = 0;

    cout << "Enter a number: ";
    cin >> number;

    if (number < 0) {
        cout << "Not a palindrome";
        return 0;
    }

    original = number;

    while (number > 0) {
        int digit = number % 10;
        reversed = reversed * 10 + digit;
        number /= 10;
    }

    if (original == reversed)
        cout << "Palindrome number";
    else
        cout << "Not a palindrome";

    return 0;
}
