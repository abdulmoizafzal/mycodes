
#include <iostream>
using namespace std;

class BankAccount {
private:
    double balance;

public:
    BankAccount() {
        balance = 1000;
    }

    void deposit(double amount) {
        if (amount > 0) {
            balance += amount;
            cout << "Deposit successful!\n";
        } else {
            cout << "Invalid amount!\n";
        }
    }

    void withdraw(double amount) {
        if (amount > 0 && amount <= balance) {
            balance -= amount;
            cout << "Withdrawal successful!\n";
        } else {
            cout << "Invalid amount or insufficient balance!\n";
        }
    }

    void showBalance() {
        cout << "Current balance: " << balance << endl;
    }
};

int main() {
    BankAccount account;

    account.showBalance();
    account.deposit(500);
    account.withdraw(200);
    account.showBalance();

    return 0;
}
