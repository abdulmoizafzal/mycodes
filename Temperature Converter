
#include <iostream>
using namespace std;

int main() {
    double temperature;
    int choice;

    cout << "1. Celsius to Fahrenheit\n";
    cout << "2. Fahrenheit to Celsius\n";
    cout << "Enter choice: ";
    cin >> choice;

    cout << "Enter temperature: ";
    cin >> temperature;

    switch (choice) {
        case 1:
            cout << "Fahrenheit: "
                 << (temperature * 9 / 5) + 32;
            break;

        case 2:
            cout << "Celsius: "
                 << (temperature - 32) * 5 / 9;
            break;

        default:
            cout << "Invalid choice!";
    }

    return 0;
}
