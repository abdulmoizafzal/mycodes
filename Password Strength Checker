
#include <iostream>
#include <string>
#include <cctype>
using namespace std;

int main() {
    string password;
    bool uppercase = false;
    bool lowercase = false;
    bool digit = false;
    bool special = false;

    cout << "Enter a password: ";
    getline(cin, password);

    for (char ch : password) {
        if (isupper(ch))
            uppercase = true;
        else if (islower(ch))
            lowercase = true;
        else if (isdigit(ch))
            digit = true;
        else
            special = true;
    }

    int score = uppercase + lowercase + digit + special;

    if (password.length() >= 8 && score == 4)
        cout << "Strong password!";
    else if (password.length() >= 6 && score >= 2)
        cout << "Moderate password!";
    else
        cout << "Weak password!";

    return 0;
}
