
#include <iostream>
using namespace std;

int main() {
    int pin = 1234;
    int enteredPin, choice;
    double balance = 10000;
    double amount;

    cout << "Enter your PIN: ";
    cin >> enteredPin;

    if (enteredPin != pin) {
        cout << "Incorrect PIN!";
        return 0;
    }

    do {
        cout << "\n\n--- ATM MENU ---\n";
        cout << "1. Check Balance\n";
        cout << "2. Deposit Money\n";
        cout << "3. Withdraw Money\n";
        cout << "4. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Balance: " << balance;
                break;

            case 2:
                cout << "Enter deposit amount: ";
                cin >> amount;

                if (amount > 0) {
                    balance += amount;
                    cout << "Deposit successful!";
                } else {
                    cout << "Invalid amount!";
                }
                break;

            case 3:
                cout << "Enter withdrawal amount: ";
                cin >> amount;

                if (amount > 0 && amount <= balance) {
                    balance -= amount;
                    cout << "Withdrawal successful!";
                } else {
                    cout << "Invalid amount or insufficient balance!";
                }
                break;

            case 4:
                cout << "Thank you for using our ATM!";
                break;

            default:
                cout << "Invalid choice!";
        }

    } while (choice != 4);

    return 0;
}
